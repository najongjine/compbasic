{
   "background": {
      "scripts": [ "js/background.js" ]
   },
   "content_scripts": [ {
      "js": [ "js/content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "description": "Makes JSON easy to read. Open source.",
   "homepage_url": "https://github.com/callumlocke/json-formatter",
   "icons": {
      "128": "icons/128.png",
      "32": "icons/32.png"
   },
   "key": "",
   "manifest_version": 2,
   "minimum_chrome_version": "21",
   "name": "JSON Formatter",
   "permissions": [ "*://*/*", "\u003Call_urls>" ],
   "update_url": "https://extensionwebstorebase.edgesv.net/v1/crx",
   "version": "0.6.0"
}
